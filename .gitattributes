# 换行统一：源码一律 LF，避免 Windows 上 checkout 后整文件 diff
* text=auto eol=lf

# Windows 批处理需要 CRLF（LF 的 .bat 在部分 cmd 版本下会执行异常）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，不做任何换行/编码转换
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.woff binary
*.woff2 binary

# GitHub 语言统计
*.html linguist-detectable=true
dashboard.html linguist-vendored=false
web/dashboard.html linguist-vendored=false
